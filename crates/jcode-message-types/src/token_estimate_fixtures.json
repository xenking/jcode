но, чтобы модель могла продолжить работу, не теряя нить. Если провайдер уже сообщил реальный размер последнего запроса, используется это число, а оценивается только то, что добавилось после него.", "counts": [0, 0, 0, 53, 53, 11, 334, 54, 0, 0]}, "rust_code": {"text": "pub fn estimate(family: TokenFamily, text: &str) -> usize {\n    let mut counts = [0u64; CLASSES];\n    for (idx, ch) in text.chars().enumerate() {\n        if ch.is_ascii_alphabetic() {\n            counts[Class::Letters as usize] += 1;\n        } else if ch.is_ascii_digit() {\n            counts[Class::Digits as usize] += 1;\n        }\n        if idx % 64 == 0 { continue; }\n    }\n    counts.iter().sum::<u64>() as usize\n}\n", "counts": [214, 50, 10, 126, 54, 70, 0, 0, 0, 0]}, "json_tool_output": {"text": "{\"files\":[{\"path\":\"crates/jcode-base/src/compaction.rs\",\"matches\":3,\"size\":104233},{\"path\":\"crates/jcode-compaction-core/src/lib.rs\",\"matches\":12,\"size\":28411}],\"truncated\":false,\"elapsed_ms\":184,\"status\":\"ok\"}", "counts": [129, 26, 17, 0, 0, 64, 0, 0, 0, 0]}, "cjk_and_symbols": {"text": "上下文窗口已使用 85%，需要压缩。 ✅ done → next ─── ░░░▒▒▓ 日本語のテキスト 한국어 텍스트", "counts": [8, 2, 2, 10, 10, 1, 0, 0, 28, 11]}}}