use std::collections::HashSet;
use std::time::{Duration, Instant};

struct SwarmMember {
    session_id: String,
    status: String,
    last_status_change: Instant,
    detail: Option<String>,
    is_headless: bool,
}

@@OWNER_PREDICATE@@

mod reload_recovery {
    #[derive(PartialEq)]
    pub enum ReloadRecoveryStatus { Pending }
    pub struct Record {
        pub status: ReloadRecoveryStatus,
        pub reload_id: String,
    }
}

mod worker_revive {
    pub fn open_lane_continuation(_: &str) -> Option<String> {
        Some("unfinished work".into())
    }
}

struct Fixture { running_before_restart: HashSet<String> }

fn restored_session_was_interrupted() -> bool { true }

impl Fixture {
    fn resumes(&self, owner_live: bool, current: bool) -> bool {
        let session_id = "worker".to_string();
        let current_reload_id = current.then(|| "current".to_string());
        let stored_recovery_record = current.then(|| reload_recovery::Record {
            status: reload_recovery::ReloadRecoveryStatus::Pending,
            reload_id: "current".into(),
        });
        @@STORED_INTENT@@
        @@OPEN_LANE@@
        let was_interrupted = @@INTERRUPTION_GUARD@@ && restored_session_was_interrupted();
        @@SHOULD_RESUME@@
        should_resume
    }
}

fn main() {
    let boundary = Instant::now();
    for case in ["reload", "historical", "stopped"] {
        let member = SwarmMember {
            session_id: "owner".into(),
            status: "stopped".into(),
            last_status_change: if case == "stopped" {
                boundary + Duration::from_secs(1)
            } else {
                boundary - Duration::from_secs(1)
            },
            detail: Some("client not attached after server restart".into()),
            is_headless: false,
        };
        let before = if case == "historical" {
            HashSet::new()
        } else {
            HashSet::from(["owner".into()])
        };
        if coordinator_was_live_at_restart(&member, &before, boundary) {
            println!("owner {case}");
        }
    }
    for owner in [false, true] {
        for current in [false, true] {
            for running in [false, true] {
                let fixture = Fixture {
                    running_before_restart: if running {
                        HashSet::from(["worker".into()])
                    } else {
                        HashSet::new()
                    },
                };
                if fixture.resumes(owner, current) {
                    println!("resume {owner} {current} {running}");
                }
            }
        }
    }
}
