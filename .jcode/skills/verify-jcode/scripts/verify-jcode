#!/usr/bin/env python3
"""Drive the real Jcode CLI/TUI with a loopback-only deterministic provider."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import plistlib
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid

REPO = Path(__file__).resolve().parents[4]
ACK = "[verify-jcode] ack. saw_cloud_notice=False"
TOOL_CONTENT = "verification tool side effect\n"


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def dump(path, value):
    temporary = path.with_name(path.name + ".next")
    temporary.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n")
    temporary.replace(path)


def digest(path):
    checksum = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            checksum.update(chunk)
    return checksum.hexdigest()


def run(argv, **kwargs):
    return subprocess.run([str(x) for x in argv], check=True, capture_output=True,
                          text=True, timeout=kwargs.pop("timeout", 30), **kwargs)


def identity(pid):
    result = subprocess.run(["ps", "-p", str(pid), "-o", "lstart=", "-o", "pgid="],
                            capture_output=True, text=True, timeout=5)
    return result.stdout.strip() if result.returncode == 0 else None


def alive(pid):
    result = subprocess.run(["ps", "-p", str(pid), "-o", "stat="],
                            capture_output=True, text=True, timeout=5)
    return result.returncode == 0 and not result.stdout.strip().startswith("Z")


def launch_agent_path(label):
    if sys.platform != "darwin":
        return None
    result = subprocess.run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"],
                            capture_output=True, text=True, timeout=5)
    if result.returncode:
        if "Could not find service" in result.stderr:
            return None
        raise RuntimeError(f"Cannot inspect launch agent {label}: {result.stderr.strip()}")
    match = re.search(r"(?m)^\s*path = (.+)$", result.stdout)
    require(match, f"Cannot determine launch agent path: {label}")
    return match.group(1).strip()


def hotkey_path():
    return launch_agent_path("com.jcode.hotkey")


def runtime_helpers(root):
    listing = run(["ps", "-axo", "pid=,command="]).stdout
    expected = (root / "jcode").resolve()
    processes = []
    for line in listing.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) != 3:
            continue
        args = parts[2].split()
        if args[:1] != ["companion"] and args[:2] != ["setup-hotkey", "--listen-macos-hotkey"]:
            continue
        if Path(parts[1]).resolve() != expected:
            continue
        pid = int(parts[0])
        start = identity(pid)
        if start:
            processes.append({"pid": pid, "identity": start})
    return processes


def stop_runtime_helpers(root):
    for process in runtime_helpers(root):
        pid = process["pid"]
        if not alive(pid):
            continue
        require(identity(pid) == process["identity"], "Helper PID identity changed")
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 5
        while alive(pid) and time.monotonic() < deadline:
            time.sleep(0.1)
        if alive(pid):
            require(identity(pid) == process["identity"], "Helper PID reused during cleanup")
            os.kill(pid, signal.SIGKILL)
            wait_for(lambda: not alive(pid), "runtime helper shutdown", 5)
    require(not runtime_helpers(root), "Runtime helper remains after cleanup")


def cleanup_runtime_launch_agents(root, original_hotkey):
    if sys.platform != "darwin":
        return
    directory = root / "home/Library/LaunchAgents"
    for plist in directory.glob("*.plist"):
        with plist.open("rb") as source:
            label = plistlib.load(source).get("Label")
        require(isinstance(label, str) and re.fullmatch(r"[A-Za-z0-9_.-]+", label),
                f"Invalid runtime launch agent label in {plist}")
        current = launch_agent_path(label)
        if not current or Path(current).resolve() != plist.resolve():
            continue
        if label == "com.jcode.hotkey" and current == original_hotkey:
            continue
        run(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{label}"])


def wait_for(predicate, description, timeout=45):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.1)
    raise RuntimeError(f"Timeout: {description}")


def completed_turn(messages, token):
    users = [i for i, message in enumerate(messages)
             if message.get("role") == "user" and token in json.dumps(message.get("content"))]
    return bool(users) and any(message.get("role") == "assistant" and ACK in json.dumps(message.get("content"))
                               for message in messages[users[-1] + 1:])


def load_persisted(path):
    """Read the snapshot plus append journal, matching session/persistence.rs."""
    snapshot = path.read_bytes()
    journal_path = path.with_suffix(".journal.jsonl")
    journal = journal_path.read_bytes() if journal_path.exists() else b""
    data = json.loads(snapshot)
    messages = data.get("messages", [])
    for line in journal.splitlines(keepends=True):
        if not line.endswith(b"\n"):
            continue  # A writer may still be appending the final line.
        entry = json.loads(line)
        messages.extend(entry.get("append_messages", []))
    # A checkpoint can leave a stale journal briefly. Production also dedupes IDs.
    seen = set()
    data["messages"] = []
    for message in messages:
        message_id = message.get("id")
        if message_id and message_id in seen:
            continue
        seen.add(message_id)
        data["messages"].append(message)
    return data if path.read_bytes() == snapshot else None


class Harness:
    def __init__(self, evidence):
        self.evidence = Path(evidence).resolve()
        self.state = json.loads((self.evidence / "run.json").read_text())
        require(self.state["schema"] == 1, "Unsupported run manifest")
        require(self.state["evidence"] == str(self.evidence), "Moved manifest, refusing to drive")
        self.root = Path(self.state["runtime"])
        require(self.evidence != self.root.resolve() and self.root.resolve() not in self.evidence.parents,
                "Evidence must be outside disposable runtime")
        if not self.state.get("cleaned"):
            require((self.root / "owner").read_text() == self.state["owner"], "Runtime ownership mismatch")
        self.env = self.state["env"]
        self.binary = self.root / "jcode"

    def save(self):
        dump(self.evidence / "run.json", self.state)

    def event(self, **data):
        with (self.evidence / "actions.jsonl").open("a") as out:
            out.write(json.dumps({"at": time.time(), **data}) + "\n")

    def spawn(self, name, argv, env=None):
        with (self.evidence / f"{name}.log").open("a") as out:
            child = subprocess.Popen([str(x) for x in argv], env=env or self.env,
                                     cwd=self.root / "workspace", stdin=subprocess.DEVNULL,
                                     stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        self.state["processes"][name] = {"pid": child.pid, "identity": identity(child.pid)}
        self.save()
        self.event(action="spawn", name=name, argv=[str(x) for x in argv], pid=child.pid)
        return child

    def tmux(self, *args):
        return run([self.state["tmux"], "-S", self.root / "tmux.sock", *args], env=self.env).stdout

    def pane(self):
        return self.tmux("capture-pane", "-p", "-S", "-1000", "-t", "verify")

    def send(self, text):
        self.event(action="terminal-input", text=text, keys=["Enter"])
        self.tmux("send-keys", "-t", "verify", "-l", text)
        self.tmux("send-keys", "-t", "verify", "Enter")

    def observe(self, command):
        require(command in {"state", "history", "side-panel:stats"}, "Not an observation")
        return self.debug("client:" + command)

    def debug(self, command, private_exec=False):
        require(command in {"server:info", "clients:map", "client:state", "client:history",
                            "client:frame", "client:side-panel:stats"}
                or private_exec and command == "reload:verify-exec",
                "Not a read-only server command")
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(10)
            connection.connect(str(self.root / "app-debug.sock"))
            connection.sendall((json.dumps({"type": "debug_command", "id": 1,
                                           "command": command}) + "\n").encode())
            with connection.makefile("r") as reader:
                response = json.loads(reader.readline())
        require(response.get("ok"), f"Debug request failed: {response}")
        return json.loads(response["output"])

    def records(self):
        path = self.evidence / "provider.jsonl"
        if not path.exists():
            return []
        lines = path.read_text().splitlines()
        return [json.loads(line) for line in lines if line.endswith("}")]

    def request_after(self, text, start):
        return wait_for(lambda: next((r for r in self.records()[start:]
                                     if text in json.dumps(r["messages"])), None),
                        f"fresh HTTP provider request containing {text}")

    def persisted(self, session_id, text):
        path = self.root / "data/sessions" / f"{session_id}.json"

        def saved():
            try:
                data = load_persisted(path)
                return data if data and completed_turn(data.get("messages", []), text) else None
            except (FileNotFoundError, json.JSONDecodeError):
                return None
        return wait_for(saved, f"persisted transcript {session_id}: {text}")

    def idle(self, timeout=45):
        return wait_for(lambda: not (s := self.observe("state"))["processing"]
                        and not s["queued_messages"], "idle TUI", timeout)

    def frame(self, label):
        require(re.fullmatch(r"[a-zA-Z0-9_-]+", label), "Frame label must be a basename")
        dump(self.evidence / f"{label}.frame.json", self.debug("client:frame"))
        text = self.pane()
        (self.evidence / f"{label}.txt").write_text(text)
        dump(self.evidence / f"{label}.state.json", self.observe("state"))
        return text

    def cli(self, label, prompt, mode="json", resume=None):
        argv = [str(self.binary), "--no-update", "--no-selfdev", "--provider", "openai-compatible",
                "--model", "fake-model", "--socket", str(self.root / "app.sock")]
        if resume:
            argv += ["--resume", resume]
        argv += ["run", *([] if mode == "plain" else ["--" + mode]), "--", prompt]
        self.event(action="cli", label=label, argv=argv)
        try:
            result = subprocess.run(argv, cwd=self.root / "workspace", env=self.env,
                                    text=True, capture_output=True, timeout=60)
            (self.evidence / f"{label}.stdout").write_text(result.stdout)
            (self.evidence / f"{label}.stderr").write_text(result.stderr)
            dump(self.evidence / f"{label}.command.json", {"argv": argv, "exit_code": result.returncode})
            require(result.returncode == 0, f"CLI exit {result.returncode}, see {label}.stderr")
            if mode == "json":
                output = json.loads(result.stdout)
                require(output.get("text") == ACK and output.get("session_id"), "Invalid JSON completion")
                return output
            if mode == "ndjson":
                events = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
                require(events and events[0].get("type") == "start", "Missing NDJSON start")
                require(events[-1].get("type") == "done" and events[-1].get("text") == ACK,
                        "Missing NDJSON completion")
                require(events[0].get("session_id") == events[-1].get("session_id"),
                        "NDJSON completion changed session")
            else:
                expected = ACK + "\n[Tokens] upload: 1 download: 1"
                require(result.stdout.strip() == expected, f"CLI reply mismatch, see {label}.stdout")
            return result.stdout
        except subprocess.TimeoutExpired as error:
            dump(self.evidence / f"{label}.command.json", {"argv": argv, "timeout": True})
            (self.evidence / f"{label}.stdout").write_bytes(error.stdout or b"")
            (self.evidence / f"{label}.stderr").write_bytes(error.stderr or b"")
            raise

    def start_tui(self, resume=None):
        argv = [str(self.binary), "--fresh-spawn", "--no-update", "--no-selfdev", "--provider", "openai-compatible",
                "--model", "fake-model", "--debug-socket", "--socket", str(self.root / "app.sock")]
        if resume:
            argv += ["--resume", resume]
        self.event(action="tui-launch", argv=argv)
        command = shlex.join(["/usr/bin/env", "-i", *[f"{k}={v}" for k, v in self.env.items()], *argv])
        self.tmux("-f", "/dev/null", "new-session", "-d", "-s", "verify",
                  "-x", str(self.state["cols"]), "-y", str(self.state["rows"]),
                  "-c", str(self.root / "workspace"), command)
        pid = int(self.tmux("display-message", "-p", "#{pid}").strip())
        self.state["processes"]["tmux"] = {"pid": pid, "identity": identity(pid)}
        client_pid = int(self.tmux("display-message", "-p", "-t", "verify", "#{pane_pid}").strip())
        self.state["processes"]["client"] = {"pid": client_pid, "identity": identity(client_pid)}
        self.save()

        def ready():
            text = self.pane()
            if "Welcome to jcode" in text:
                self.event(action="onboarding", keys=["Right", "Enter"], purpose="skip optional setup")
                self.tmux("send-keys", "-t", "verify", "Right", "Enter")
            return "Ready to use" in text or (resume and ACK in text)
        def attached():
            try:
                return bool(self.observe("state").get("remote_session_id"))
            except RuntimeError as error:
                if "No TUI client connected" not in str(error):
                    raise
                return False
        wait_for(ready, "usable TUI prompt")
        wait_for(attached, "TUI daemon attachment")
        self.frame("launch" if not resume else "launch-resume-" + uuid.uuid4().hex[:8])

    def doctor(self):
        require(not self.state.get("cleaned"), "Instance has been cleaned. Launch a new run.")
        require(digest(self.binary) == self.state["binary_sha256"], "Running binary digest changed")
        require(digest(Path(__file__)) == self.state["helper_sha256"], "Helper changed; relaunch before driving")
        require(digest(REPO / "scripts/fake_openai_server.py") == self.state["provider_sha256"],
                "Fake-provider fixture changed; relaunch before driving")
        for name, process in self.state["processes"].items():
            require(alive(process["pid"]) and identity(process["pid"]) == process["identity"],
                    f"Process no longer owned/alive: {name}")
        # No inherited proxies and no authentication to external endpoints.
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(self.env["JCODE_OPENAI_COMPAT_API_BASE"] + "/models", timeout=5) as response:
            require(json.load(response)["data"][0]["id"] == "fake-model", "Wrong provider catalog")
        server = self.debug("server:info")
        require(server["git_hash"] and server["git_hash"] in self.state["binary_version"],
                "Daemon build does not match launched binary")
        state = self.observe("state")
        require(state.get("remote_session_id"), "TUI not attached")
        clients = self.debug("clients:map")["clients"]
        require(len(clients) == 1 and clients[0]["session_id"] == state["remote_session_id"],
                "Expected exactly our TUI client on the isolated daemon")
        report = {"status": "ready", "binary_sha256": self.state["binary_sha256"],
                  "binary_version": self.state["binary_version"], "server": server,
                  "session_id": state["remote_session_id"], "model": state["model"],
                  "runtime": str(self.root), "provider": self.env["JCODE_OPENAI_COMPAT_API_BASE"]}
        dump(self.evidence / "doctor.json", report)
        return report

    def reload_background(self, token, start, label, finish_before_attach=False, wait_in_turn=False):
        routed = bool(self.env.get("JCODE_EXEC_WORKER"))
        gate = self.root / "control" / token.replace("-", "_")
        sid = self.observe("state")["remote_session_id"]
        status_dir = self.root / "jcode-bg-tasks"
        before = {p.name for p in status_dir.glob("*.status.json")}
        flags = " verify-no-bg-wake" if wait_in_turn else ""
        self.send(f"{token} [e2e:reload-bg:{gate.name}]{flags}")
        self.request_after(token, start)
        self.idle()

        def load_status(path):
            try:
                return json.loads(path.read_text())
            except (OSError, ValueError):
                return {}

        def new_task():
            for path in status_dir.glob("*.status.json"):
                task = load_status(path)
                if path.name not in before and task.get("session_id") == sid and task.get("tool_name") == "bash":
                    return path

        path = wait_for(new_task, "original background task registration")
        task = load_status(path)
        os_pid = wait_for(lambda: int(gate.with_suffix(".child").read_text())
                          if gate.with_suffix(".child").exists() else None, "original command PID")
        require(task.get("status") == "running" and task.get("notify") and task.get("wake") == (not wait_in_turn),
                f"Expected running task with the requested delivery flags: {task}")
        require(alive(os_pid) and alive(task["pid"]), "Original shell or supervisor is not alive")
        daemon_pid = self.state["processes"]["server"]["pid"]
        old_server = self.debug("server:info")["id"]
        if wait_in_turn:
            wait_prompt = f"{token}_wait [e2e:reload-wait:{task['task_id']}]"
            self.send(wait_prompt)
            self.request_after(wait_prompt, start)
            wait_for(lambda: "Verify original wait survives daemon exec" in self.pane()
                     and self.observe("state")["processing"], "the original bg wait is in flight")
        self.event(action="private-exec", daemon_pid=daemon_pid, shell_pid=os_pid)
        tui_closed = False
        try:
            if finish_before_attach:
                self.frame(label + "-running")
                self.tmux("kill-session", "-t", "verify")
                tui_closed = True
            reload_id = self.debug("reload:verify-exec", private_exec=True)["request_id"]

            def new_server():
                try:
                    server = self.debug("server:info")
                    return server if server["id"] != old_server else None
                except (OSError, RuntimeError, ValueError):
                    return None

            successor = wait_for(new_server, "replacement process image", 25)
            trace = self.root / "data/reload-traces" / (reload_id + ".jsonl")
            shutil.copy2(trace, self.evidence / f"{label}-exec.jsonl")
            require(any(event.get("phase") == "exec_start" and event.get("pid") == daemon_pid
                        and Path(event.get("binary", "")).resolve() == self.binary.resolve()
                        for event in map(json.loads, trace.read_text().splitlines())),
                    "No exec trace for the original daemon PID and staged binary")
            require(alive(daemon_pid), "Exec did not preserve daemon PID")
            if not finish_before_attach:
                wait_for(lambda: any(client["session_id"] == sid for client in self.debug("clients:map")["clients"]),
                         "TUI reattached to its original session", 25)
            require(alive(os_pid) and alive(task["pid"]) and load_status(path).get("pid") == task["pid"]
                    and load_status(path).get("status") == "running", "Exec lost the original running task")
            gate.with_suffix(".progress").touch()
            if not routed:
                wait_for(lambda: (load_status(path).get("progress") or {}).get("message") == "post-exec progress",
                         "progress recorded by replacement daemon")
            if finish_before_attach:
                gate.with_suffix(".release").touch()
                wait_for(lambda: load_status(path).get("exit_code") == 23, "completion while owner is offline")
                require(not any(client["session_id"] == sid for client in self.debug("clients:map")["clients"]),
                        "Owner had already reattached before completion")
            else:
                self.frame(label + "-running")
        finally:
            gate.with_suffix(".progress").touch()
            gate.with_suffix(".release").touch()
        if tui_closed:
            self.start_tui(resume=sid)
        wait_for(lambda: load_status(path).get("exit_code") == 23, "original code 23 recorded")
        finished = load_status(path)
        output = status_dir / (task["task_id"] + ".output")
        require(finished.get("status") == "failed" and "completed by original shell" in output.read_text(),
                f"Missing original output or exit status: {finished}")
        if not wait_in_turn:
            wait_for(lambda: "exit 23" in self.pane(), "visible TUI background completion")
            # The fixture text in the assistant's command is not a wake.
            wait_for(lambda: any(m.get("role") == "user"
                                 and f"**Background task** `{task['task_id']}`" in json.dumps(m.get("content"))
                                 and "completed by original shell" in json.dumps(m.get("content"))
                                 for entry in self.records()[start:] if entry.get("agent")
                                 for m in entry["messages"][-2:]), "provider request from task wake")
        wait_for(lambda: load_status(path).get("completion_delivered") is True,
                 "durable completion acknowledgement")
        self.idle()
        if wait_in_turn:
            requests = [entry for entry in self.records()[start:] if entry.get("agent")
                        and any(wait_prompt in json.dumps(m.get("content")) for m in entry["messages"])]
            require(len(requests) >= 2, "No provider continuation for the original wait")
            first_continuation = requests[1]["messages"]
            require(any(m.get("role") == "tool" and m.get("tool_call_id") == "call_reload_wait"
                        and "Exit code: 23" in json.dumps(m.get("content"))
                        and "completed by original shell" in json.dumps(m.get("content"))
                        for m in first_continuation), "The first continued provider request lacks the original wait result")
        dump(self.evidence / f"{label}-task.json", load_status(path))
        return {"task_id": task["task_id"], "daemon_pid": daemon_pid, "shell_pid": os_pid,
                "previous_server_id": old_server, "server_id": successor["id"],
                "session_id": sid, "exit_code": finished["exit_code"], "reload_id": reload_id}

    def reload_selfdev(self, token, label):
        workspace = self.root / "workspace"
        (workspace / ".git").mkdir(exist_ok=True)
        (workspace / "Cargo.toml").write_text('[package]\nname = "jcode"\n')
        locks = self.root / "data/selfdev-build-locks"
        locks.mkdir(exist_ok=True)
        status_dir = self.root / "jcode-bg-tasks"
        sid = self.observe("state")["remote_session_id"]
        before = {path.name for path in status_dir.glob("*.status.json")}

        def read_status(path):
            try:
                return json.loads(path.read_text())
            except (OSError, ValueError):
                return {}

        def registered_job(action):
            for path in status_dir.glob("*.status.json"):
                status = read_status(path)
                if (path.name not in before and status.get("session_id") == sid
                        and status.get("tool_name") == f"selfdev-{action}"):
                    return path, status

        with (locks / "test-worktree-scope.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            jobs = []
            for action in ("build", "test"):
                start = len(self.records())
                self.send(f"{token}_{action} [e2e:reload-selfdev:{action}]")
                self.request_after(f"{token}_{action}", start)
                self.idle()
                path, task = wait_for(lambda: registered_job(action), f"selfdev {action} registration")
                require(task.get("detached") and task.get("status") == "running" and alive(task["pid"]),
                        f"Expected detached selfdev {action} worker blocked on private lock: {task}")
                jobs.append((action, path, task))

            old_server = self.debug("server:info")["id"]
            daemon_pid = self.state["processes"]["server"]["pid"]
            reload_id = self.debug("reload:verify-exec", private_exec=True)["request_id"]

            def new_server():
                try:
                    server = self.debug("server:info")
                    return server if server["id"] != old_server else None
                except (OSError, RuntimeError, ValueError):
                    return None

            successor = wait_for(new_server, "replacement process image", 25)
            require(alive(daemon_pid), "Exec did not preserve daemon PID")
            wait_for(lambda: any(c["session_id"] == sid for c in self.debug("clients:map")["clients"]),
                     "TUI reattached to its original session", 25)
            for action, path, task in jobs:
                successor_task = read_status(path)
                require(successor_task.get("status") == "running" and successor_task.get("pid") == task["pid"]
                        and alive(task["pid"]), f"Reload lost original selfdev {action} PID {task['pid']}")
            fcntl.flock(lock, fcntl.LOCK_UN)

        results = {}
        for action, path, task in jobs:
            wait_for(lambda: read_status(path).get("status") == "completed", f"selfdev {action} completion")
            status = read_status(path)
            output = (status_dir / (task["task_id"] + ".output")).read_text()
            require(status.get("exit_code") == 0 and f"Simulated selfdev {action}" in output,
                    f"Missing real queue-fixture result for {action}: {status}")
            dump(self.evidence / f"{label}-{action}.json", status)
            results[action] = {"task_id": task["task_id"], "pid": task["pid"], "exit_code": 0}
        return {"jobs": results, "daemon_pid": daemon_pid, "reload_id": reload_id,
                "previous_server_id": old_server, "server_id": successor["id"], "session_id": sid}

    def drive(self, feature, mode, text=None, keys=None, expect=None):
        self.doctor()
        self.state["drive_sequence"] = self.state.get("drive_sequence", 0) + 1
        number = self.state["drive_sequence"]
        self.save()
        label = f"drive-{number:03d}-{feature}"
        start = len(self.records())
        token = f"verify_{feature}_{uuid.uuid4().hex[:10]}"
        self.frame(label + "-before")
        result = {"feature": feature, "entry_point": feature, "token": token, "status": "failed"}
        try:
            if feature in {"input", "keys"}:
                require(expect, "Exploratory drives require --expect visible-text")
                if feature == "input":
                    require(text, "input requires --text")
                    self.send(text)
                else:
                    require(keys, "keys requires --keys with tmux key names")
                    self.event(action="terminal-keys", keys=keys)
                    self.tmux("send-keys", "-t", "verify", *keys)
                wait_for(lambda: expect in self.pane(), f"visible text {expect!r}")
                self.frame(label + "-after")
                result.update(status="observed", expected_text=expect)
                return result
            if feature == "draft-models":
                socket_path = self.root / "api.sock"
                env = dict(self.env, JCODE_SOCKET=str(self.root / "app.sock"),
                           JCODE_API_SOCKET=str(socket_path))
                self.spawn("api-bridge", [self.binary, "--no-update", "--no-selfdev", "api-bridge"], env)
                wait_for(socket_path.is_socket, "private API bridge socket")
                session_dir = self.root / "data/sessions"
                before_files = sorted(path.name for path in session_dir.iterdir())
                with socket.socket(socket.AF_UNIX) as connection:
                    connection.settimeout(8)
                    connection.connect(str(socket_path))
                    with connection.makefile("rwb") as wire:
                        def call(request_id, request, **fields):
                            frame = {"v": 1, "id": request_id, "req": request, **fields}
                            self.event(action="api-request", frame=frame)
                            wire.write((json.dumps(frame) + "\n").encode())
                            wire.flush()
                            for line in wire:
                                reply = json.loads(line)
                                if reply.get("reply_to") == request_id:
                                    return reply
                            raise RuntimeError("Private bridge closed before replying")

                        hello = call(1, "hello", min_version=1, max_version=1, client="verify-jcode/draft-models")
                        require("draft_model_catalog" in hello.get("capabilities", []), "Missing draft catalog capability")
                        before = call(2, "list_sessions")
                        models = call(3, "list_draft_models")
                        after = call(4, "list_sessions")
                require(models.get("ev") == "draft_models" and models.get("current") == "fake-model",
                        f"Unexpected draft catalog: {models}")
                require(any(route["model"] == "fake-model" and route["available"] for route in models["routes"]),
                        "Fake provider's ready model is absent from the draft catalog")
                require(before.get("ev") == after.get("ev") == "sessions",
                        f"ListSessions did not return a catalog: {before}, {after}")
                before_ids = sorted(session["session_id"] for session in before["sessions"])
                after_ids = sorted(session["session_id"] for session in after["sessions"])
                require(before_ids == after_ids,
                        f"Reading the catalog changed the set of sessions: {before_ids} -> {after_ids}")
                require(sorted(path.name for path in session_dir.iterdir()) == before_files,
                        "Reading the catalog created persistent state")
                require(len(self.records()) == start, "The draft catalog triggered inference")
                result.update(status="passed", models=models, session_count=len(after["sessions"]))
                return result
            if feature == "cli":
                output = self.cli(label, token, mode)
                result["mode"] = mode
                self.request_after(token, start)
                sessions = list((self.root / "data/sessions").glob("session_*.json"))
                matches = [p for p in sessions if token in p.read_text()]
                require(matches, "CLI transcript was not persisted")
                for path in matches:
                    require(completed_turn(json.loads(path.read_text())["messages"], token),
                            "CLI saved no completed reply for the fresh prompt")
                    shutil.copy2(path, self.evidence / f"{label}-{path.name}")
                result["output"] = output
            elif feature == "cancel":
                sid = self.observe("state")["remote_session_id"]
                gate = self.root / "control" / token
                try:
                    self.send(token + f" [e2e:hold:{token}]")
                    self.request_after(token, start)
                    wait_for(lambda: gate.with_suffix(".held").exists(), "held provider request")
                    require(self.observe("state")["processing"], "Held turn is not processing")
                    self.frame(label + "-held")
                    self.event(action="terminal-keys", keys=["Escape"], purpose="cancel held turn")
                    self.tmux("send-keys", "-t", "verify", "Escape")
                    self.idle()
                    saved = load_persisted(self.root / "data/sessions" / f"{sid}.json")
                    require(saved and any(token in json.dumps(m.get("content"))
                                          for m in saved["messages"]), "Cancelled prompt was lost")
                    require(not completed_turn(saved["messages"], token), "Cancelled turn completed")
                    dump(self.evidence / f"{label}-cancelled-session.json", saved)
                    self.frame(label + "-cancelled")
                finally:
                    gate.with_suffix(".release").write_text("release cancelled fixture request\n")
                    self.event(action="fixture-release", token=token)
                self.send(token + "_continued")
                self.request_after(token + "_continued", start)
                self.idle()
                require(self.observe("state")["remote_session_id"] == sid, "Cancel changed session ID")
                result["session_id"] = sid
                dump(self.evidence / f"{label}-session.json", self.persisted(sid, token + "_continued"))
            elif feature in {"reload-bg", "reload-bg-before-attach", "reload-bg-wait"}:
                result.update(self.reload_background(token, start, label,
                    finish_before_attach=feature == "reload-bg-before-attach", wait_in_turn=feature == "reload-bg-wait"))
            elif feature == "reload-selfdev":
                result.update(self.reload_selfdev(token, label))
            elif feature in {"resume", "restart", "mode-set"}:
                if feature == "mode-set":
                    self.send("/mode toggle verify-probe")
                    self.send("/mode toggle verify-review")
                    self.send("/mode")
                    wait_for(lambda: "Session mode: verify-probe, verify-review" in self.pane(),
                             "both session modes enabled")
                self.send(token)
                self.request_after(token, start)
                self.idle()
                sid = self.observe("state")["remote_session_id"]
                original = self.persisted(sid, token)
                self.frame(label + "-original")
                self.tmux("kill-session", "-t", "verify")
                wait_for(lambda: not alive(self.state["processes"]["tmux"]["pid"]), "old terminal shutdown", 10)
                if feature in {"restart", "mode-set"}:
                    old_server_id = self.debug("server:info")["id"]
                    process = self.state["processes"]["server"]
                    require(alive(process["pid"]) and identity(process["pid"]) == process["identity"],
                            "Daemon process ownership changed")
                    self.event(action="daemon-stop", pid=process["pid"], signal="SIGTERM")
                    os.killpg(process["pid"], signal.SIGTERM)
                    wait_for(lambda: not alive(process["pid"]), "old daemon shutdown", 15)
                    self.spawn("server", [self.binary, "--no-update", "--no-selfdev", "--provider",
                                          "openai-compatible", "--model", "fake-model", "--debug-socket",
                                          "--socket", self.root / "app.sock", "serve"])

                    def restarted():
                        try:
                            return self.debug("server:info")["id"] != old_server_id
                        except (OSError, RuntimeError):
                            return False
                    wait_for(restarted, "new isolated daemon identity")
                    result["previous_server_id"] = old_server_id
                    result["server_id"] = self.debug("server:info")["id"]
                self.start_tui(resume=sid)
                self.doctor()
                require(self.observe("state")["remote_session_id"] == sid, "Resume changed session ID")
                require(token in self.pane(), "Resumed TUI did not restore original prompt")
                self.send(token + "_continued")
                self.request_after(token + "_continued", start)
                self.idle()
                result["session_id"] = sid
                saved = self.persisted(sid, token + "_continued")
                original_ids = [m["id"] for m in original["messages"]]
                require([m["id"] for m in saved["messages"][:len(original_ids)]] == original_ids,
                        "Resume changed the original transcript prefix")
                dump(self.evidence / f"{label}-session.json", saved)
                if feature == "mode-set":
                    expected_modes = ["verify-probe", "verify-review"]
                    require(original.get("pinned_skills") == saved.get("pinned_skills") == expected_modes,
                            "Mode set did not survive daemon restart and an ordinary prompt")
                    continued = [r for r in self.records()[start:] if r.get("agent")
                                 and token + "_continued" in json.dumps(r["messages"])]
                    require(continued, "No post-restart provider request")
                    messages = json.dumps(continued[0]["messages"])
                    require("VERIFY_PROBE_SKILL_BODY" in messages and "VERIFY_REVIEW_SKILL_BODY" in messages,
                            "The post-restart provider request did not include both modes")
                    self.send("/mode toggle verify-probe")
                    self.send("/mode")
                    wait_for(lambda: "Session mode: verify-review" in self.pane(), "removed only the first mode")
                    result["retained_modes"] = expected_modes
                    result["after_toggle"] = ["verify-review"]
            elif feature == "mode":
                # Session mode must reach the provider for every later turn,
                # survive a real compaction, and reach a spawned worker.
                def probe_in(record):
                    return "VERIFY_PROBE_SKILL_BODY" in json.dumps(record["messages"])
                self.send("/mode verify-probe")
                wait_for(lambda: "Session mode: verify-probe" in self.pane(), "pinned mode notice")
                for n in range(5):
                    self.send(f"{token}_pad{n} [e2e:pad]")
                    self.request_after(f"{token}_pad{n}", start)
                    self.idle(180)
                self.frame(label + "-padded")
                self.send("/compact")
                wait_for(lambda: "compacted" in self.pane(), "completed compaction", 120)
                self.idle(180)
                self.frame(label + "-compacted")
                post = len(self.records())
                self.send(token + "_after")
                self.request_after(token + "_after", post)
                self.idle()
                after = [r for r in self.records()[post:] if r.get("agent")
                         and token + "_after" in json.dumps(r["messages"])]
                require(after, "No provider request for the post-compaction turn")
                require("Previous Conversation Summary" in json.dumps(after[0]["messages"]),
                        "Post-compaction request carries no compaction summary")
                require(probe_in(after[0]), "Pinned skill missing from the post-compaction request")
                spawn = len(self.records())
                self.send(token + "_spawn [e2e:spawn]")

                def child_request():
                    return [r for r in self.records()[spawn:] if r.get("agent")
                            and "[e2e:child]" in json.dumps(r["messages"][-1:])]
                wait_for(child_request, "spawned worker provider request", 90)
                child = child_request()[0]
                require(probe_in(child), "Spawned worker did not inherit the pinned skill")
                dump(self.evidence / f"{label}-post-compaction-request.json", after[0])
                dump(self.evidence / f"{label}-child-request.json", child)
                self.idle()
                self.send("/mode off")
                wait_for(lambda: "Session mode: off" in self.pane(), "mode off notice")
                result["session_id"] = self.observe("state")["remote_session_id"]
                self.frame(label + "-after")
                result["status"] = "passed"
                return result
            else:
                prompt = token
                if feature == "tui":
                    # Reset only this harness-owned fixture, so a previous write
                    # cannot make a failed current tool execution look successful.
                    (self.root / "workspace/verify-tool.txt").unlink(missing_ok=True)
                    self.event(action="fixture-reset", path="verify-tool.txt")
                    prompt += " [e2e:verify-write]"
                elif feature == "slash":
                    self.send("/help")
                    wait_for(lambda: "Esc to close" in self.pane(), "help modal")
                    self.frame(label + "-help")
                    self.event(action="terminal-keys", keys=["Escape"], purpose="close help modal")
                    self.tmux("send-keys", "-t", "verify", "Escape")
                    wait_for(lambda: "Esc to close" not in self.pane(), "composer after help")
                    prompt = "/verify-probe " + token
                self.send(prompt)
                self.request_after(token, start)
                self.idle()
                sid = self.observe("state")["remote_session_id"]
                saved = self.persisted(sid, token)
                dump(self.evidence / f"{label}-session.json", saved)
                if feature == "tui":
                    path = self.root / "workspace/verify-tool.txt"
                    require(path.read_text() == TOOL_CONTENT, "Real write tool side effect missing")
                    shutil.copy2(path, self.evidence / f"{label}-verify-tool.txt")
                    require(any(m.get("role") == "tool" for r in self.records()[start:]
                                for m in r["messages"]), "Tool result never reached provider")
                elif feature == "slash":
                    require("Activated skill: verify-probe" in self.pane(), "Skill activation not rendered")
                    require(any("VERIFY_PROBE_SKILL_BODY" in json.dumps(r["messages"])
                                for r in self.records()[start:]), "Skill body not delivered to provider")
                elif feature == "side-panel":
                    self.send("/splitview on")
                    def panel_ready():
                        self.debug("client:frame")
                        panel = self.debug("client:side-panel:stats").get("live") or {}
                        return (panel.get("page_id") == "split_view"
                                and panel.get("pane_width_cells", 0) > 0
                                and panel.get("total_lines", 0) > 0)
                    wait_for(panel_ready, "visible populated split-view panel")
                    dump(self.evidence / f"{label}-panel.json", self.debug("client:side-panel:stats"))
                result["session_id"] = sid
            text = self.frame(label + "-after")
            if feature != "cli":
                require(ACK in text and token in text, "Fresh prompt and assistant reply not visible in terminal")
            if feature == "tui":
                require("write · Prove a real tool side effect" in text, "Real tool row not rendered")
            result["status"] = "passed"
        except BaseException as error:
            result["error"] = str(error)
            try:
                self.frame(label + "-failed")
            except (OSError, RuntimeError, subprocess.SubprocessError):
                pass
            raise
        finally:
            dump(self.evidence / f"{label}.json", result)
        return result

    def cleanup(self):
        if self.state.get("cleaned"):
            return {"status": "already-cleaned", "evidence": str(self.evidence)}
        errors = []
        initial_hotkey = self.state.get("hotkey_path")
        if "hotkey_path" not in self.state:
            errors.append("Missing initial hotkey path; cannot verify host state")
        try:
            current_hotkey = hotkey_path()
            if current_hotkey != initial_hotkey:
                errors.append(f"Global hotkey path changed: {initial_hotkey!r} -> {current_hotkey!r}")
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            errors.append(str(error))
        for name in ("client", "tmux", "server", "provider"):
            process = self.state["processes"].get(name)
            if not process or not alive(process["pid"]):
                continue
            if identity(process["pid"]) != process["identity"]:
                errors.append(f"PID identity mismatch: {name}. Refusing to kill.")
                continue
            try:
                if name == "tmux":
                    self.tmux("kill-server")
                elif name == "client":
                    os.kill(process["pid"], signal.SIGTERM)
                else:
                    os.killpg(process["pid"], signal.SIGTERM)
                deadline = time.monotonic() + 5
                while alive(process["pid"]) and time.monotonic() < deadline:
                    time.sleep(0.1)
                if alive(process["pid"]):
                    require(identity(process["pid"]) == process["identity"], "PID reused during cleanup")
                    if name == "client":
                        os.kill(process["pid"], signal.SIGKILL)
                    else:
                        os.killpg(process["pid"], signal.SIGKILL)
                wait_for(lambda: not alive(process["pid"]), f"{name} shutdown", 5)
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                errors.append(str(error))
        for action in (lambda: cleanup_runtime_launch_agents(self.root, initial_hotkey),
                       lambda: stop_runtime_helpers(self.root)):
            try:
                action()
            except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
                errors.append(str(error))
        try:
            final_hotkey = hotkey_path()
            if final_hotkey != initial_hotkey:
                errors.append(f"Global hotkey path changed: {initial_hotkey!r} -> {final_hotkey!r}")
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            errors.append(str(error))
        require(not errors, "; ".join(errors))
        # All writers are stopped before the final independent disk snapshot.
        if (self.root / "data/sessions").exists():
            shutil.copytree(self.root / "data/sessions", self.evidence / "sessions", dirs_exist_ok=True)
        require((self.root / "owner").read_text() == self.state["owner"], "Ownership changed")
        shutil.rmtree(self.root)
        self.state["cleaned"] = True
        self.save()
        report = {"status": "cleaned", "runtime_removed": not self.root.exists(),
                  "hotkey_path_before": initial_hotkey, "hotkey_path_after": final_hotkey,
                  "evidence": str(self.evidence), "artifacts": len(list(self.evidence.iterdir()))}
        dump(self.evidence / "cleanup.json", report)
        return report


def launch(args):
    binary = Path(args.binary).resolve(strict=True)
    require(args.cols >= 40 and args.rows >= 15, "Terminal must be at least 40x15")
    require(binary.is_file() and os.access(binary, os.X_OK), "Binary must be executable")
    tmux = shutil.which("tmux")
    require(tmux, "Install tmux before launch")
    binary_sha256 = digest(binary)
    initial_hotkey = hotkey_path()
    repo_head = run(["git", "-C", REPO, "rev-parse", "HEAD"]).stdout.strip()
    evidence = Path(args.evidence).resolve()
    evidence.mkdir(mode=0o700, parents=True, exist_ok=False)
    os.chmod(evidence, 0o700)
    root = Path(tempfile.mkdtemp(prefix="jv-", dir="/tmp")).resolve()
    owner = uuid.uuid4().hex
    (root / "owner").write_text(owner)
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": str(root / "home"),
           "LANG": "en_US.UTF-8", "TERM": "xterm-256color", "TMPDIR": str(root),
           "JCODE_HOME": str(root / "data"), "JCODE_RUNTIME_DIR": str(root),
           "XDG_CONFIG_HOME": str(root / "home/.config"), "XDG_CACHE_HOME": str(root / "home/.cache"),
           "JCODE_TEST_SESSION": "1", "JCODE_DEBUG_CONTROL": "1", "JCODE_NO_MENUBAR": "1",
           "JCODE_VERIFY_EXEC_RELOAD": "1",
           "JCODE_NO_TELEMETRY": "1", "JCODE_TELEMETRY": "off",
           "JCODE_NO_AUTO_UPDATE": "1", "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null",
           "GIT_TERMINAL_PROMPT": "0", "OPENAI_COMPAT_API_KEY": "synthetic-verification-key",
           "JCODE_OPENAI_COMPAT_DEFAULT_MODEL": "fake-model",
           "JCODE_DEBUG_CMD_PATH": str(root / "debug.cmd"),
           "JCODE_DEBUG_RESPONSE_PATH": str(root / "debug.response")}
    state = {"schema": 1, "owner": owner, "evidence": str(evidence), "runtime": str(root),
             "cols": args.cols, "rows": args.rows,
             "source_binary": str(binary), "binary_sha256": binary_sha256, "tmux": tmux,
             "helper_sha256": digest(Path(__file__)),
             "provider_sha256": digest(REPO / "scripts/fake_openai_server.py"),
             "processes": {}, "env": env, "repo_head": repo_head, "hotkey_path": initial_hotkey}
    dump(evidence / "run.json", state)
    harness = Harness(evidence)
    try:
        for name in ("home", "data", "workspace", "control"):
            (root / name).mkdir()
        shutil.copy2(binary, root / "jcode")
        if args.loopback_exec_worker:
            env["JCODE_EXEC_WORKER"] = shlex.join([str(root / "jcode"), "server", "exec-worker"])
        skill = root / "workspace/.jcode/skills/verify-probe"
        skill.mkdir(parents=True)
        (skill / "SKILL.md").write_text(
            '---\nname: verify-probe\ndescription: Isolated verification fixture\n---\n'
            'VERIFY_PROBE_SKILL_BODY\nAcknowledge the user prompt.\n')
        review = root / "workspace/.jcode/skills/verify-review"
        review.mkdir(parents=True)
        (review / "SKILL.md").write_text(
            '---\nname: verify-review\ndescription: A second isolated verification skill\n---\n'
            'VERIFY_REVIEW_SKILL_BODY\nAcknowledge the user prompt.\n')
        harness.state["binary_version"] = run([root / "jcode", "--no-update", "--version"], env=env).stdout.strip()
        harness.save()
        (evidence / "source.diff").write_text(run(["git", "-C", REPO, "diff", "HEAD"]).stdout)
        provider_env = dict(env, FAKE_LOG=str(evidence / "provider.jsonl"), FAKE_LABEL="verify-jcode",
                            FAKE_PORT_FILE=str(root / "provider.port"), FAKE_CONTROL_DIR=str(root / "control"))
        harness.spawn("provider", [sys.executable, REPO / "scripts/fake_openai_server.py", "0"], provider_env)
        port = wait_for(lambda: (root / "provider.port").read_text().strip()
                        if (root / "provider.port").exists() else None, "fake provider port")
        harness.env["JCODE_OPENAI_COMPAT_API_BASE"] = f"http://127.0.0.1:{int(port)}/v1"
        harness.save()
        harness.spawn("server", [root / "jcode", "--no-update", "--no-selfdev", "--provider", "openai-compatible",
                                  "--model", "fake-model", "--debug-socket", "--socket", root / "app.sock", "serve"])
        wait_for(lambda: (root / "app-debug.sock").exists(), "isolated daemon debug socket")
        # Usable means a completed real inference, not merely a listening socket.
        harness.cli("launch-warm", "verify launch readiness")
        harness.start_tui()
        return harness.doctor()
    except BaseException as error:
        dump(evidence / "launch-failure.json", {"error": str(error)})
        try:
            (evidence / "launch-failure.txt").write_text(harness.pane())
        except (OSError, subprocess.SubprocessError):
            pass
        harness.cleanup()
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    start = sub.add_parser("launch", help="Launch an isolated daemon/provider/TUI from a built binary")
    start.add_argument("--binary", required=True)
    start.add_argument("--evidence", required=True, help="New evidence directory, survives cleanup")
    start.add_argument("--cols", type=int, default=160)
    start.add_argument("--rows", type=int, default=48)
    start.add_argument("--loopback-exec-worker", action="store_true",
                       help="Route Bash through the staged executable's execution worker, with no SSH")
    for name in ("doctor", "drive", "frame", "cleanup"):
        command = sub.add_parser(name)
        command.add_argument("--evidence", required=True)
        if name == "drive":
            command.add_argument("feature", choices=["cli", "tui", "slash", "resume", "restart", "reload-bg", "reload-bg-before-attach", "reload-bg-wait", "reload-selfdev", "cancel",
                                                     "side-panel", "mode", "mode-set", "draft-models", "input", "keys"])
            command.add_argument("--mode", choices=["plain", "json", "ndjson"], default="json")
            command.add_argument("--text", help="Text for exploratory input drive")
            command.add_argument("--keys", nargs="+", help="tmux keys, e.g. Escape or C-u")
            command.add_argument("--expect", help="Required visible text for exploratory drives")
        if name == "frame":
            command.add_argument("--label", default="manual")
    args = parser.parse_args()
    os.umask(0o077)
    if args.command == "launch":
        print(json.dumps(launch(args), indent=2))
        return
    evidence = Path(args.evidence).resolve()
    # Fail closed instead of racing file-debug requests from two agents.
    lock = evidence / ".lock"
    lock.mkdir()
    try:
        harness = Harness(evidence)
        try:
            if args.command == "doctor":
                result = harness.doctor()
            elif args.command == "drive":
                result = harness.drive(args.feature, args.mode, args.text, args.keys, args.expect)
            elif args.command == "frame":
                harness.doctor()
                harness.frame(args.label)
                result = {"frame": str(evidence / f"{args.label}.frame.json")}
            else:
                result = harness.cleanup()
        except BaseException:
            if args.command != "cleanup":
                try:
                    harness.cleanup()
                except Exception as error:
                    print(f"verify-jcode: cleanup failed: {error}", file=sys.stderr)
            raise
        print(json.dumps(result, indent=2))
    finally:
        lock.rmdir()


if __name__ == "__main__":
    def terminate(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGINT, terminate)
    signal.signal(signal.SIGTERM, terminate)
    try:
        main()
    except KeyboardInterrupt:
        print("verify-jcode: interrupted", file=sys.stderr)
        sys.exit(130)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"verify-jcode: {error}", file=sys.stderr)
        sys.exit(1)
